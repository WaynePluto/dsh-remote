{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "release/**", "docs/reference/**"],
  "rules": {
    "no-console": "off",
    "typescript/consistent-type-imports": "error",
    "unicorn/require-module-specifiers": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["require_", "__DSH_STATION_ITERATOR_POLYFILLED__", "__DSH_STATION_BROWSER_COMPAT__"] }]
  }
}
