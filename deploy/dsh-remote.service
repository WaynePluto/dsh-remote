# /etc/systemd/system/dsh-remote.service
#
# 一台 dsh-remote 机器 = 一个 launcher 进程 + 它自己拉起的三个子进程（dsh / relay / connector）。
# 这个 unit 只管 launcher，不要再给 relay 或 connector 单独写 unit：三个子进程的启动顺序、
# 关闭顺序和 JWT 密钥都由 launcher 负责（packages/launcher/src/index.ts）。
#
# 适用对象：一台需要长期在线的入口机器（hub），通常是 Linux 服务器。
# 桌面成员机器不需要这个文件，见同目录的 README.md。
#
# 这是个人用户模式：launcher、dsh、relay、connector 都以同一个普通用户运行，
# 让 dsh 的能力接近该用户通过 SSH 登录后的开发环境；不要把它配置成 root 服务。
#
# 需要替换的占位符：
#   <user>                         日常登录的普通用户；必须已经存在
#   <group>                        该用户的主组（可与用户名相同，也可按实际情况填写）
#   /opt/dsh-remote                解压出来的绿色包所在目录（保持只读）
#   /etc/dsh-remote/dsh-remote.config.json   launcher 配置文件
#   /home/<user>/.dsh-remote       dsh-remote home：relay.db、relay-jwt.secret、membership.json、device.key
#   /home/<user>/.dsh              DSH_HOME：dsh 的 profiles / settings / credentials / sessions
#   /home/<user>                   dsh 里的 agent 默认工作目录，也是下面的 WorkingDirectory
#   /usr/bin/node                  Node 22.19+ 的绝对路径，用 `command -v node` 确认

[Unit]
Description=dsh-remote (dsh + relay + connector, supervised by the launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
Group=<group>

# 工作目录同时是 dsh 新会话的起始目录：dsh 拿自己的进程 cwd 当默认会话 cwd
#（dsh 的 packages/api/session-controller/src/commands.ts 里 create 不带 cwd 时用
# defaultCwd，即 dsh 进程的 cwd），三个子进程又都继承 launcher 的 cwd。
# 个人模式从用户家目录开始，目录选择器也会从这里开始列出目录。
# launcher 自身不依赖当前目录：配置用 --config 显式指定，
# dsh / relay / connector 的入口都按 launcher 的安装位置解析。
WorkingDirectory=/home/<user>
# 绿色包里的启动器入口是 dist/index.js（源码仓库里是 packages/launcher/dist/index.js）。
# 解压后用 `ls /opt/dsh-remote/dist` 确认一次再填。
ExecStart=/usr/bin/node /opt/dsh-remote/dist/index.js --config /etc/dsh-remote/dsh-remote.config.json

# HOME 决定 node 的 os.homedir()，也决定默认的 dsh-remote home（$HOME/.dsh-remote）。
Environment=HOME=/home/<user>
# 与官方 dsh 共用标准 DSH_HOME（铁律 10 / D14）；显式写出便于 systemd 环境核对。
Environment=DSH_HOME=/home/<user>/.dsh
# relay、connector 和 launcher 都读这个变量（pino 的日志级别）。
Environment=LOG_LEVEL=info
# 不要在这里写 DSH_REMOTE_JWT_SECRET：launcher 首次运行会自己生成
# /home/<user>/.dsh-remote/relay-jwt.secret（0600）并传给 relay 子进程。
# 也不要在这里写 DSH_REMOTE_ADMIN_PASSWORD：它只在一次性的 init 命令里用。

Restart=always
RestartSec=5
# 任一子进程意外退出时，launcher 会打印它最后 50 行日志、把其余进程一起停掉，
# 然后自己以退出码 1 结束 —— 这是故意的，它不会偷偷重启子进程
#（packages/launcher/src/supervisor.ts 的 onUnexpectedExit）。
# 所以把服务重新拉起来的是上面这条 Restart=always，而不是 launcher 自己。
# 想在崩溃循环时让 systemd 早点放弃，可加 StartLimitIntervalSec= / StartLimitBurst=。

# 只把 SIGTERM 发给主进程，让 launcher 按 connector -> relay -> dsh 的顺序自己收尾；
# 每个子进程最多等 5 秒再 SIGKILL，三个加起来的最坏情况留足余量后再由 systemd 收尸。
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45

# ---- 个人用户模式的文件系统与提权边界 ----
# dsh 应当看到与该用户 SSH 登录后相同的家目录和系统路径。
# 这些限制若打开，会分别屏蔽 /home、阻止 sudo 获得新权限，或把系统目录挂成只读，
# 因此这里明确关闭；个人用户的 Unix 权限、sudoers 和 dsh-remote 登录认证仍然生效。
NoNewPrivileges=false
PrivateTmp=false
ProtectHome=false
ProtectSystem=false
UMask=0077

# 不使用 StateDirectory / ReadWritePaths：运行数据位于用户自己的 ~/.dsh-remote，
# dsh 的工作区也可以是该用户本来就有权限访问的任意目录。
# 不要再加 MemoryDenyWriteExecute=true：它会直接打死 V8 的 JIT，Node 起不来。
# 同理，收紧 SystemCallFilter= / RestrictAddressFamilies= 之前先想清楚 dsh 会派生
# shell、PTY 和 pnpm，这些加固项很容易把 agent 的工具链一起挡掉。

[Install]
WantedBy=multi-user.target
