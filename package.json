{
  "name": "dsh-remote-root",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "node --import tsx scripts/dev-stack.mjs",
    "start": "node --import tsx scripts/dev-stack.mjs --built",
    "relay:init": "node scripts/relay-cli.mjs init",
    "relay:passwd": "node scripts/relay-cli.mjs passwd",
    "relay:totp-reset": "node scripts/relay-cli.mjs totp reset",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/pack.mjs --target=all",
    "release:win": "node scripts/pack.mjs --target=win32-x64",
    "release:linux": "node scripts/pack.mjs --target=linux-x64",
    "release:mac": "node scripts/pack.mjs --target=darwin-arm64",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r --if-present test",
    "check:dependencies": "node scripts/check-dependency-versions.mjs"
  },
  "devDependencies": {
    "@dsh-remote/dsh-plugin-agents-md": "workspace:*",
    "@dsh-remote/dsh-plugin-browser-compat": "workspace:*",
    "@dsh-remote/dsh-plugin-chat-scroll": "workspace:*",
    "@dsh-remote/dsh-plugin-concise-mode": "workspace:*",
    "@dsh-remote/dsh-plugin-copilot-auth": "workspace:*",
    "@dsh-remote/dsh-plugin-directory-picker-browse": "workspace:*",
    "@dsh-remote/dsh-plugin-exec-process": "workspace:*",
    "@dsh-remote/dsh-plugin-favorite-models": "workspace:*",
    "@dsh-remote/dsh-plugin-files": "workspace:*",
    "@dsh-remote/dsh-plugin-model-capabilities": "workspace:*",
    "@dsh-remote/dsh-plugin-models-catalog": "workspace:*",
    "@dsh-remote/dsh-plugin-notify": "workspace:*",
    "@dsh-remote/dsh-plugin-proxy": "workspace:*",
    "@dsh-remote/dsh-plugin-remote-privileged": "workspace:*",
    "@dsh-remote/dsh-plugin-remote-settings": "workspace:*",
    "@dsh-remote/dsh-plugin-services": "workspace:*",
    "@dsh-remote/dsh-plugin-skills-inspector": "workspace:*",
    "@dsh-remote/dsh-plugin-subagent-depth": "workspace:*",
    "@dsh-remote/dsh-plugin-terminal": "workspace:*",
    "@dsh-remote/dsh-plugin-tools-inspector": "workspace:*",
    "@dsh-remote/dsh-plugin-turn-retry": "workspace:*",
    "@dsh-remote/dsh-plugin-user-message-fork": "workspace:*",
    "@dsh-remote/dsh-plugin-yolo-mode": "workspace:*",
    "@types/node": "22.20.4",
    "archiver": "8.0.0",
    "husky": "9.1.7",
    "oxlint": "1.83.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
